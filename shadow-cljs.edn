{:deps {:aliases [:cljs]}

 :dev-http {3000 "resources/public"}

 :builds
 {:app
  {:target     :browser
   :output-dir "resources/public/js/compiled"
   :asset-path "/js/compiled"
   :modules    {:procedurals {:entries [procedurals.core]}}
   :devtools   {:after-load procedurals.core/on-js-reload}}

  :terrain
  {:target     :browser
   :output-dir "resources/public/js/compiled-terrain"
   :asset-path "/js/compiled-terrain"
   :modules    {:terrain {:entries [procedurals.terrain-webgl]}}}}}
