{:deps {:aliases [:cljs]}

 :dev-http {3000 "resources/public"}

 :builds
 {:app
  {:target     :browser
   :output-dir "resources/public/js/compiled"
   :asset-path "/js/compiled"
   :modules    {:procedurals {:entries [procedurals.core procedurals.terrain-webgl procedurals.boids-viewer procedurals.boids-3d]}}
   :devtools   {:after-load procedurals.core/on-js-reload}}}}
