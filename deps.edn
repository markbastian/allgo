;; The library is src/cljc and depends on nothing but Clojure. The browser
;; demos (src/cljs), the desktop viewers (src/clj), the demo site
;; (resources) and the libraries only they use live under :demo.
{:paths ["src/cljc"]

 :deps {org.clojure/clojure {:mvn/version "1.12.6"}}

 :aliases
 {:build
  {:deps       {io.github.clojure/tools.build {:mvn/version "0.10.14"}}
   :ns-default build}

  :demo
  {:extra-paths ["src/clj" "src/cljs" "resources"]
   :extra-deps  {org.clojure/clojurescript {:mvn/version "1.12.145"}
                 org.clojure/core.async    {:mvn/version "1.10.874-alpha3"
                                            :exclusions  [org.clojure/tools.reader]}
                 quil/quil                 {:mvn/version "4.3.1563"}
                 reagent/reagent           {:mvn/version "2.0.1"}
                 clojure-lanterna/clojure-lanterna {:mvn/version "0.9.7"}}}

  :cljs
  {:extra-deps    {thheller/shadow-cljs {:mvn/version "3.5.7"}}
   :override-deps {org.clojure/clojure {:mvn/version "1.12.6"}}}

  :test
  {:extra-paths ["test" "resources"]
   :extra-deps  {io.github.cognitect-labs/test-runner
                 {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
   :main-opts   ["-m" "cognitect.test-runner"]}

  :nrepl
  {:extra-deps {nrepl/nrepl       {:mvn/version "1.8.0"}
                cider/cider-nrepl {:mvn/version "0.63.1"}}
   :main-opts  ["-m" "nrepl.cmdline" "--middleware" "[cider.nrepl/cider-middleware]"]}}}
